# ==============================================================================
# SOCIAL LISTENING - UNIFIED ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Telegram Bot (Alerts & Digest Dispatch)
# ------------------------------------------------------------------------------
# Create bot via @BotFather on Telegram, get chat ID via @userinfobot or @getidsbot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------------------------
# 2. Reddit API (Required for Social-ops collector; free script app)
# ------------------------------------------------------------------------------
# Create script app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=social-ops/0.1
REDDIT_RATE_LIMIT_RPM=45
REDDIT_CONCURRENCY=2

# ------------------------------------------------------------------------------
# 3. Apify (Optional for Facebook / Instagram / AppStore scrape fallback)
# ------------------------------------------------------------------------------
# Get token at https://console.apify.com/account/integrations ($5/mo free credit)
APIFY_API_TOKEN=

# ------------------------------------------------------------------------------
# 4. LLM Intent Classifier & Summarizer (Optional)
# ------------------------------------------------------------------------------
# Defaults to local proxy or OpenAI-compatible endpoint
LLM_BASE_URL=http://127.0.0.1:8317/v1
LLM_API_KEY=devtoken
LLM_MODEL=gemini-3.7-flash-high
INTENT_LLM_ENABLED=true

# ------------------------------------------------------------------------------
# 5. Social-Ops FastMCP Host
# ------------------------------------------------------------------------------
MCP_BASE=http://localhost:8097
