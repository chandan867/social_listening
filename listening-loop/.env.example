# ==============================================================================
# Listening Loop - Environment Variables
# ==============================================================================

# 1. Telegram Bot (required for alert delivery; digest still generates locally without it)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 2. LLM Gateway for Intent Classification & Daily Summarization (Optional)
# Defaults to local CLIProxyAPI / OpenAI-compatible endpoint
LLM_BASE_URL=http://127.0.0.1:8317/v1
LLM_API_KEY=devtoken
LLM_MODEL=gemini-3.7-flash-high
INTENT_LLM_ENABLED=true

# 3. Social-Ops FastMCP Backend (Optional override, defaults to http://localhost:8097)
MCP_BASE=http://localhost:8097

# 4. Optional Reddit API Direct Keys (If not using Social-ops container)
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=social-ops/0.1
